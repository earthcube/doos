@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:     <http://www.earthcube.org/schema#> .
@prefix schema: <https://schema.org/> .

#################################################################
# Google Dataset SHACL shape  (Stage 3 of the SHACL-for-AI flow)
#
# Targets schema:Dataset. ALL schema.org IRIs use the canonical
# https://schema.org/ namespace (PLAN.md §0a.4) so they byte-match
# the RDF emitted by Stage 2. (The earlier draft used http://; that
# would silently match nothing and report a false "conforms".)
#
# Severity split, per Google's Rich Results "Dataset" guidance:
#   * sh:Violation (REQUIRED)   -> blocks conformance. Only name +
#     description are truly required; contentUrl is required *inside*
#     a distribution when one is present.
#   * sh:Warning   (RECOMMENDED)-> reported and repaired when
#     possible, but does not by itself fail conformance.
#
# Stage 4 reads sh:resultSeverity to decide blocking vs. advisory.
#
# Reference: https://schema.org/Dataset
#   https://developers.google.com/search/docs/appearance/structured-data/dataset
#################################################################

<http://www.earthcube.org/schema>
    rdf:type owl:Ontology ;
    owl:imports <http://datashapes.org/dash> ;
.

#################################################################
# REQUIRED  (sh:Violation)
#################################################################

ex:NameShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: schema:name must be a single non-empty text value."@en ;
    ] ;
.

ex:DescriptionShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:description ;
        sh:name "description" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 50 ;
        sh:maxLength 5000 ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: schema:description must be text between 50 and 5000 characters."@en ;
    ] ;
.

#################################################################
# RECOMMENDED  (sh:Warning)
#################################################################

ex:UrlShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:url ;
        sh:name "url" ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: provide schema:url (the dataset landing page)."@en ;
    ] ;
.

ex:IdentifierShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:identifier ;
        sh:name "identifier" ;
        sh:minCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:nodeKind sh:IRI ]
            [ sh:class schema:PropertyValue ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:identifier as text, IRI (e.g. a DOI), or PropertyValue."@en ;
    ] ;
.

ex:KeywordsShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:keywords ;
        sh:name "keywords" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: provide one or more schema:keywords (text)."@en ;
    ] ;
.

ex:LicenseShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:license ;
        sh:name "license" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:nodeKind sh:IRI ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:license as an IRI (preferred) or text."@en ;
    ] ;
.

ex:CreatorShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:creator ;
        sh:name "creator" ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class schema:Person ]
            [ sh:class schema:Organization ]
            [ sh:nodeKind sh:IRI ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:creator as a schema:Person or schema:Organization."@en ;
    ] ;
.

ex:PublisherShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:publisher ;
        sh:name "publisher" ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class schema:Person ]
            [ sh:class schema:Organization ]
            [ sh:nodeKind sh:IRI ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:publisher as a schema:Person or schema:Organization."@en ;
    ] ;
.

ex:CitationShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:citation ;
        sh:name "citation" ;
        sh:minCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:class schema:CreativeWork ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:citation as text or a schema:CreativeWork."@en ;
    ] ;
.

ex:VariableMeasuredShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:variableMeasured ;
        sh:name "variableMeasured" ;
        sh:minCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:class schema:PropertyValue ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:variableMeasured as text or schema:PropertyValue."@en ;
    ] ;
.

ex:TemporalCoverageShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:temporalCoverage ;
        sh:name "temporalCoverage" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:temporalCoverage as ISO 8601 interval text."@en ;
    ] ;
.

ex:SpatialCoverageShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:spatialCoverage ;
        sh:name "spatialCoverage" ;
        sh:minCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:class schema:Place ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:spatialCoverage as text or a schema:Place."@en ;
    ] ;
.

ex:SameAsShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:sameAs ;
        sh:name "sameAs" ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:sameAs (a reference URL for the dataset)."@en ;
    ] ;
.

ex:AlternateNameShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:alternateName ;
        sh:name "alternateName" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:not [ sh:nodeKind sh:IRI ] ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:alternateName must be a literal, not an IRI."@en ;
    ] ;
.

ex:VersionShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:version ;
        sh:name "version" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:nodeKind sh:Literal ]
            [ sh:class schema:Number ]
        ) ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: schema:version as text or a number."@en ;
    ] ;
.

ex:DistributionShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:distribution ;
        sh:name "distribution" ;
        sh:minCount 1 ;
        sh:node ex:DataDownloadShape ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED: provide at least one schema:distribution (schema:DataDownload)."@en ;
    ] ;
.

#################################################################
# Shape for each schema:DataDownload reached via schema:distribution
#################################################################

ex:DataDownloadShape
    a sh:NodeShape ;
    # contentUrl is REQUIRED *within* a distribution when one is present.
    sh:property [
        sh:path schema:contentUrl ;
        sh:name "contentUrl" ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED within a distribution: schema:contentUrl (direct download link)."@en ;
    ] ;
    sh:property [
        sh:path schema:encodingFormat ;
        sh:name "encodingFormat" ;
        sh:nodeKind sh:Literal ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "RECOMMENDED within a distribution: schema:encodingFormat (e.g. \"text/csv\")."@en ;
    ] ;
.

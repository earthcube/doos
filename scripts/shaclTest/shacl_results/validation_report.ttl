@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
_:r0 a sh:ValidationReport ;
	sh:conforms false ;
	sh:result _:r1 , _:r2 .
_:r1 a sh:ValidationResult ;
	sh:focusNode <http://example.org/base/nan> ;
	sh:resultPath <https://schema.org/description> ;
	sh:resultSeverity sh:Violation ;
	sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
	sh:sourceShape _:1_b0 .
_:r2 a sh:ValidationResult ;
	sh:focusNode <http://example.org/base/nan> ;
	sh:resultPath <https://schema.org/name> ;
	sh:resultSeverity sh:Violation ;
	sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
	sh:sourceShape _:1_b1 .

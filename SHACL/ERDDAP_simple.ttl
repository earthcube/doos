@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix oihval: <https://oceans.collaborium.io/voc/validation/1.0.1/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# =============================================================================
# ERDDAP_simple.ttl
#
# This is a pyrudof / Rust SHACL engine compatible variant of ERDDAP.ttl.
#
# The ONLY difference from the original ERDDAP.ttl is in the shape
# oihval:polygonCloseProperty (see below).
#
# Reason for the change:
#   The original pattern used a regex backreference (\1):
#       "^(\\d+)\\s+(\\d+)(?:\\s+\\d+)+\\s+\\1$"
#
#   Backreferences are not supported by the Rust regex engine used by
#   rudof / pyrudof. This caused shape loading to fail with:
#       "Invalid regex pattern: backreferences are not supported"
#
# Simplified pattern:
#   "^\\d+\\s+\\d+\\s+\\d+\\s+\\d+(?:\\s+\\d+)*$"
#
# This version:
#   - Requires the value to be space-separated numbers
#   - Requires at least 4 numbers (matching the minimum implied by the original)
#   - Does NOT enforce "first value == last value" (the original intent)
#
# If you need the strict "first == last" rule, either:
#   - Use the original ERDDAP.ttl with PySHACL / Jena, or
#   - Add the check via sh:sparql (not yet supported in pyrudof as of 0.3.x)
# =============================================================================


oihval:IDShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:severity sh:Warning ;
    sh:message "Graph requires ID"@en ;
    sh:description "URL OIH shape guidance" ;
    sh:nodeKind sh:IRI ;
.

oihval:OIHCoreShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:message "OIH Search by Course validation" ;
    sh:description "OIH shape guidance" ;
    sh:property
        oihval:coreName,
        oihval:coreDescription,
        oihval:coreContacts,
        oihval:coreLicense,
        oihval:coreCitation,
        oihval:recMesType,
        oihval:recLatitude,
        oihval:recLongitude,
        oihval:recMesMethod ; .

oihval:coreName
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:severity sh:Violation ;
    sh:message "Description of what this is should go here"@en ;
    sh:minCount 1 ;
    sh:description "https://book.odis.org/thematics/docs/index.html#" ; .

oihval:coreDescription
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:severity sh:Violation ;
    sh:message "Description of what this is should go here"@en ;
    sh:minCount 1 ;
    sh:description "https://book.odis.org/thematics/docs/index.html#" ; .

oihval:coreContacts
    a sh:PropertyShape ;
    sh:path schema:contacts ;
    sh:severity sh:Warning ;
    sh:message "Contact information should be provided"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:description "https://foo.org" ; .

oihval:coreLicense
    a sh:PropertyShape ;
    sh:path schema:license ;
    sh:severity sh:Violation ;
    sh:message "License information should be provided"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:description "https://foo.org" ; .

oihval:coreCitation
    a sh:PropertyShape ;
    sh:path schema:citation ;
    sh:severity sh:Warning ;
    sh:message "Citation information should be provided"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:description "https://foo.org" ; .

oihval:recTemporal
    a sh:PropertyShape ;
    sh:path schema:temporalCoverage ;
    sh:severity sh:Warning ;
    sh:message "Description of what this is should go here"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:description "https://foo.org" ; .

oihval:recTaxon
    a sh:PropertyShape ;
    sh:path schema:taxonomicRange ;
    sh:severity sh:Warning ;
    sh:message "Description of what this is should go here"@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:description "https://foo.org" ; .

oihval:recMesType
    a sh:PropertyShape ;
    sh:path schema:variableMeasured ;
    sh:severity sh:Warning ;
    sh:message "variable measured check"@en ;
    sh:minCount 1 ;
    sh:description "https://book.odis.org/thematics/variables/index.html" ; .

oihval:recMesMethod
    a sh:PropertyShape ;
    sh:path schema:measurementMethod ;
    sh:severity sh:Warning ;
    sh:message "measurement method check"@en ;
    sh:minCount 1 ;
    sh:description "https://book.odis.org/thematics/variables/index.html" ; .

oihval:recLongitude
    sh:path schema:variableMeasured ;
        sh:qualifiedValueShape [
            a sh:NodeShape ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue schema:PropertyValue ;
                sh:minCount 1 ;
                sh:message "The node must be of type schema:PropertyValue." ;
            ] ;
            sh:property [
                sh:path schema:name ;
                sh:hasValue "longitude" ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The PropertyValue must have the name 'latitude'." ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;  # Ensures at least one PropertyValue has name "latitude"
        sh:message "At least one PropertyValue in variableMeasured must have the name 'latitude'." ; .

oihval:recLatitude
    sh:path schema:variableMeasured ;
        sh:qualifiedValueShape [
            a sh:NodeShape ;
            sh:property [
                sh:path rdf:type ;
                sh:hasValue schema:PropertyValue ;
                sh:minCount 1 ;
                sh:message "The node must be of type schema:PropertyValue." ;
            ] ;
            sh:property [
                sh:path schema:name ;
                sh:hasValue "latitude" ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:message "The PropertyValue must have the name 'latitude'." ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;  # Ensures at least one PropertyValue has name "latitude'." ;
        sh:message "At least one PropertyValue in variableMeasured must have the name 'latitude'." ; .

oihval:OIHSpatialShape
    a sh:NodeShape ;
    sh:targetClass schema:GeoShape ;
    sh:message "OIH Resource to Query validation" ;
    sh:description "OIH shape guidance" ;
    sh:property
        oihval:polygonStringProperty,
        oihval:polygonCloseProperty ;
.

oihval:polygonStringProperty
    a sh:PropertyShape ;
    sh:path schema:polygon ;
    sh:message "The string must consists of numeric, space-separated items."@en ;
    sh:maxCount 1 ;
    sh:description "https://foo.org" ;
    sh:pattern "^(?:\\d+\\s+)*\\d+$" ; .


oihval:polygonCloseProperty
    a sh:PropertyShape ;
    sh:path schema:polygon ;
    sh:message "The polygon string must have the first and last items are the same"@en ;
    sh:maxCount 1 ;
    sh:description "https://foo.org" ;
    # Simplified pattern for pyrudof/rudof compatibility.
    # Original used a backreference (\\1) which is unsupported in Rust regex.
    # This version requires at least 4 space-separated numbers.
    sh:pattern "^\\d+\\s+\\d+\\s+\\d+\\s+\\d+(?:\\s+\\d+)*$" ;
.

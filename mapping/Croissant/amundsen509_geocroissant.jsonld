            "extract": { "column": "latitude" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dataRecordSet/longitude",
          "description": "Longitude",
          "dataType": "cr:Float32",
          "source": {
            "fileSet": { "@id": "amundsen509Files" },
            "extract": { "column": "longitude" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dataRecordSet/depth",
          "description": "Depth below sea surface (metres, positive down)",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": { "@id": "amundsen509Files" },
            "extract": { "column": "depth" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dataRecordSet/TE90",
          "description": "Temperature (ITS-90)",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": { "@id": "amundsen509Files" },
            "extract": { "column": "TE90" }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "dataRecordSet/PSAL",

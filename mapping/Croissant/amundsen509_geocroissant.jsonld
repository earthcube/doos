  "name": "ArcticNet 0603c - Hudson Bay and Foxe Basin CTD data",
  "headline": "amundsen509",
  "description": "CTD profile data from ArcticNet cruise leg 0603 (October 25–27, 2006) in Hudson Bay and Foxe Basin aboard CCGS Amundsen. Twenty-one casts at eighteen stations measured temperature, salinity, pressure, oxygen, pH, fluorescence, nitrate, transmittance, and PAR. Depth range approximately 2–376 m below the sea surface (positive down).",
  "url": "https://erddap.amundsenscience.com/erddap/tabledap/amundsen509.html",
  "citeAs": "https://doi.org/10.5884/509",
  "license": "https://creativecommons.org/licenses/by/4.0",
  "identifier": "ca.cioos/ccin-509",
  "version": "1.0",
  "isLiveDataset": true,
  "dateCreated": "2024-06-26",
  "dateModified": "2024-06-26T00:00:00Z",
  "temporalCoverage": "2006-10-25T09:09:00Z/2006-10-27T18:08:00Z",
  "geocr:coordinateReferenceSystem": "EPSG:4326",
  "spatialCoverage": {
    "@type": "Place",
    "geo": [
      {
        "@type": "GeoShape",
        "description": "Horizontal bounding box (latitude/longitude, schema.org box convention)",
        "box": "63.5352 -82.1352 67.8837 -75.8348"
      },
      {
        "@type": "GeoShape",
        "description": "Vertical depth extent at dataset centroid (GeoSPARQL LINESTRING Z; Z is depth below sea surface in metres, positive down per CF geospatial_vertical_positive)",
        "geosparql:asWKT": {
          "@value": "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> LINESTRING Z (-78.985 65.70945 1.98, -78.985 65.70945 375.94)",
          "@type": "geosparql:wktLiteral"
        }
      },
      {
        "@type": "GeoShape",
        "description": "Shallow and deep bounds as GeoSPARQL POINT Z samples (OIH depth positioning claim)",
        "geosparql:asWKT": {
          "@value": "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> MULTIPOINT Z ((-78.985 65.70945 1.98), (-78.985 65.70945 375.94))",
          "@type": "geosparql:wktLiteral"
        }
      }
    ],
    "geosparql:hasGeometry": {
      "@id": "amundsen509:datasetDepthExtent",

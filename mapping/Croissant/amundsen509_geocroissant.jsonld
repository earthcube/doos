  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "dataRecordSet",
      "description": "CTD profile observations (trimmed field set from source Croissant).",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "dataRecordSet/cast_number",
          "description": "Cast Number",
          "dataType": "cr:Int32",
          "source": {
            "fileSet": { "@id": "amundsen509Files" },
            "extract": { "column": "cast_number" }
          }
        },
        {
          "@type": "cr:Field",

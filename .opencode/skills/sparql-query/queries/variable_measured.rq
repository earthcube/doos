# Inventory schema:variableMeasured PropertyValue nodes.
# Params: LIMIT, GRAPH_FILTER
PREFIX schema: <https://schema.org/>

SELECT DISTINCT ?subj ?vm ?name ?minValue ?maxValue ?propertyId ?unitCode ?unitText ?g
WHERE {
  GRAPH ?g {
    ?subj schema:variableMeasured ?vm .
    ?vm a schema:PropertyValue ;
        schema:name ?name .
    OPTIONAL { ?vm schema:minValue ?minValue . }
    OPTIONAL { ?vm schema:maxValue ?maxValue . }
    OPTIONAL { ?vm schema:propertyID ?propertyId . }
    OPTIONAL { ?vm schema:unitCode ?unitCode . }
    OPTIONAL { ?vm schema:unitText ?unitText . }
  }
  {{GRAPH_FILTER}}
}
ORDER BY ?name
LIMIT {{LIMIT}}

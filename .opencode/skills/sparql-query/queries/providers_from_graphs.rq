# Provider/repo slugs derived from Gleaner-style named graph IRIs.
# Assumes graph IRIs like urn:gleaner.io:...:<provider>:...
# Params: LIMIT
SELECT DISTINCT ?provider
WHERE {
  GRAPH ?g {
    ?s ?p ?o .
  }
  BIND(
    REPLACE(STR(?g), "^urn:gleaner\\.io:[^:]+:([^:]+):.*", "$1")
    AS ?provider
  )
  FILTER(REGEX(STR(?g), "^urn:gleaner\\.io:"))
  FILTER(?provider != STR(?g))
}
ORDER BY ?provider
LIMIT {{LIMIT}}

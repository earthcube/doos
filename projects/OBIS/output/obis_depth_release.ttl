    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/61bf70ac-2ff7-4363-b258-5802c6a5d489> ;
.

<urn:gleaner.io:oih:obis:data:0d4696ffbe53823fecfe59881db3a256cadab2ad>
    a ecsummary:Dataset ;
    ecsummary:description "This nation-wide dataset contains data on cetacean strandings recorded on the Ukrainian coast of the Black sea by researchers from a few institutions and personally reported by local residents and visitors, with photographs. Creation of the dataset was recommended by the Research Council on Marine Mammal Protection and the Ministry of Ecology and National Resources of Ukraine. Some field activities in 2017 were funded by the ACCOBAMS (project “Identification and initial assessment of cetacean groupings in coastal waters of the north-western Black Sea, Ukrainian sector”)" ;
    ecsummary:keywords "Occurrence, Black Sea, cetaceans, Observation, strandings" ;
    ecsummary:name "Data on cetacean strandings on the Ukrainian coast of the Black Sea (2017)" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/ca6b412a-6106-4c21-8a0a-9d51be84a3c8> ;
.


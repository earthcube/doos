<urn:gleaner.io:oih:obis:data:1751abd59127e5ee4e6dd2b106feaa10f9d0d6d9>
    a ecsummary:Dataset ;
    ecsummary:description "Seabird transects (n = 317) were conducted from the British Indian Ocean Territory (BIOT) patrol vessel. The sampling was primarily designed to target focal sites that were typical pelagic habitats within the MPA, such as shallow seamounts (&lt;70 m), deep banks (ca. 400 m), deep seamounts (&lt;900 m), and deep basins (&lt;2,000 m). The survey ran from 2012 to 2016 between November and April, to overlap with the moderate phase of the monsoon. This period generally coincides with peak seabird breeding activity in the Chagos Archipelago." ;
    ecsummary:keywords "Occurrence, Observation" ;
    ecsummary:name "Seabird observations, Chagos Archipelago, Indian Ocean (2012-2016)" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/a7f93b8e-19f5-420d-9c97-fa7312bbffc8> ;
.


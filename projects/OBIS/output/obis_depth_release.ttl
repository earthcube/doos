<urn:gleaner.io:oih:obis:data:bc796808e833048d0b824a7cde6fd9ec075c725b>
    a ecsummary:Dataset ;
    ecsummary:description "El presente conjunto de datos corresponde a la observaciones de crustáceos asociados a la Colección de Referencia de Biología Marina de la Universidad del Valle. En esta publicación se incluyen las observaciones (sin espécimen preservado) que estaban incluidas dentro de la publicación de la colección biológica. Contiene 675 registros correspondientes a 15 especies de crustáceos, principalmente marinos. La mayoría de los especímenes registrados pertenecen a la región del Pacífico colombiano. " ;
    ecsummary:keywords "Universidad del Valle, Pacífico colombiano, Sessilia, Observation, Occurrence, Crustácea, Decapoda, Isopoda, Stomatopoda, VALLE_DEL_CAUCA" ;
    ecsummary:name "Observaciones de Crustáceos de la Universidad del Valle (CERBMcr-UV)" ;

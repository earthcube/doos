    a ecsummary:Dataset ;
    ecsummary:description "The Zoology Laboratory of the University of Thessaloniki, has undertaken an investigation relating to the benthic fauna of the Evvoia Coast and Evvoia Gulf since 1970.  In this study were described specific benthic species. Some of them were recorded for the first time among the marine fauna of our country." ;
    ecsummary:keywords "Metadata, Samplingevent" ;
    ecsummary:name "Benthic Fauna of the Evvoia Coast and Evvoia Gulf." ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/f329c69c-6e07-4ad6-bf7c-f8dfe1a0a212> ;
.


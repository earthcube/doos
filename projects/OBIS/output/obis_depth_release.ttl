    ecsummary:keywords "Universidad del Valle, Pacífico colombiano, Sessilia, Observation, Occurrence, Crustácea, Decapoda, Isopoda, Stomatopoda, VALLE_DEL_CAUCA" ;
    ecsummary:name "Observaciones de Crustáceos de la Universidad del Valle (CERBMcr-UV)" ;

<urn:gleaner.io:oih:obis:data:8a2594582692d4aa229ef12c5a9b29b7bf1901f8>
    a ecsummary:Dataset ;
    ecsummary:description """As part of a McGill University thesis project, grab samples were collected from two fiords on Ellesmere Island, NWT during two summer. Replicate samples were collected from various depths along a transect extending out from the shore with the objective of determining depth distributions of benthic polychaetes in the two fjords.
Version 1 of this dataset includes presence information for the dominant taxa. This information was extracted from thesis appendices (Curtis 1970). Nominal latitude and longitude coordinates have been assigned to this dataset as the exact locations where the grab samples were collected was not provided.""" ;
    ecsummary:keywords "Occurrence, Observation" ;
    ecsummary:name "McGill University: Depth distributions of benthic polychaetes in two fjords on Ellesmere Island, NWT." ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/927d909a-3357-4ad8-b3b7-87d89ee0335f> ;
.


<urn:gleaner.io:oih:obis:data:ab82cb1ba80dc2874e53d3c184f8d99bea976ad7>
    a ecsummary:Dataset ;
    ecsummary:description """Deep-water scleractinian corals were collected in 2015 during cruise FK20150301 (McCulloch et al., 2017), from within and around the Perth

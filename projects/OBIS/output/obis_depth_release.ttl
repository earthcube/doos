<urn:gleaner.io:oih:obis:data:ee46b054a90875b5956a787398258666bcd3c1b1>
    a ecsummary:Dataset ;
    ecsummary:description "The dataset consists of Micro Zooplankton (MZP) occurrences obtained from water samples collected at discrete depths (surface, 10, 20, 30, 50, 75, 100, 120, and 200 meters). The sampling was carried out onboard FORV Sagar Sampada during various cruises as part of the Marine Living Resources (MLR) program in the Eastern Arabian Sea from 2003 to 2018." ;
    ecsummary:keywords "Occurrence, Microzooplankton, Arabian Sea, Indian Ocean" ;
    ecsummary:name "Micro Zooplankton (MZP) occurrences obtained from water samples collected onboard FORV Sagar Sampada during various cruises in the Arabian Sea from 2003 to 2018" ;

<urn:gleaner.io:oih:obis:data:a8f22b89dcc1f9be10e53a7aeb0d2d0ef2b5022e>
    a ecsummary:Dataset ;
    ecsummary:description "An annotated check-list is given of Xenophyophores species occurring deeper than 2000 m in the seas bordering Europe." ;

    a ecsummary:Dataset ;
    ecsummary:description "This dataset contains historical data on catch and fishing effort in Limfjord (Denmark) for various species. The data covers the time period 1690-1816." ;
    ecsummary:keywords "Catch per unit effort, Fishery statistics, Historical records, Occurrence, Observation" ;

    ecsummary:keywords "Occurrence, macrobenthos, Yellow Sea" ;
    ecsummary:name "Distribution of macrobenthos in the Yellow Sea in November 2011" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/32437d2f-4317-4c6f-a1b2-021b99a8e11b> ;

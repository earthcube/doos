<urn:gleaner.io:oih:obis:data:e5220dac7ecc60f3dab1f17bf38a276176da7b0e>
    a ecsummary:Dataset ;
    ecsummary:description "Quantifying biological assemblages and their environment is a fundamental, yet statistically challenging task in conservation ecology. Here, we use a recently developed approach called Regions of Common Profile (RCP) to quantify and map the distribution of demersal fish assemblages in an ecologically significant region of the Southern Ocean to (1) gain ecological and management insights and (2) evaluate the utility of the new method for ecoregionalization." ;
    ecsummary:keywords "Occurrence" ;
    ecsummary:name "Model-based mapping of assemblages for ecology and conservation management: A case study of demersal fish on the Kerguelen Plateau" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/3db646e3-ca43-4496-8bb2-15803fb140b4> ;
.


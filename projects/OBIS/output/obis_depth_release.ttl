<urn:gleaner.io:oih:obis:data:90314c0b91e45cade0ce6c63ec7df0560111e819>
    a ecsummary:Dataset ;
    ecsummary:description "Pop-up satellite archival tags (PAT4: n=26,Mk10: n=91,Wildlife Computers, U.S.A.) were deployed on the broadbill swordfish Xiphias gladius in waters off eastern Australia (AU; PAT4: n=26;Mk10: n=29), northern New Zealand (NZ;Mk10: n=19), south of the area between Fiji and French Polynesia in the western Pacific Ocean (SFFP; Mk10: n=13), the Cook Islands (CI;Mk10: n = 9) during 2004–2013. A total of 102 tracks are presented here." ;
    ecsummary:keywords "Occurrence, Observation" ;
    ecsummary:name "Tracking of the broadbill swordfish Xiphias gladius in the South Pacific Ocean (2004-2013)" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/96041282-9386-4a8a-a564-fd753f1222b0> ;
.


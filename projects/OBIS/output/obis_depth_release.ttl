    ecsummary:keywords "Alien species, Occurrence, Observation" ;
    ecsummary:name "Marine Non-native species records from Natural resources Wales (NRW) monitoring research and ad-hoc sightings" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;

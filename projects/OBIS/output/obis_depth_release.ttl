<urn:gleaner.io:oih:obis:data:84dd4054da1fb73601be7183fe2292ac5cdebcaf>
    a ecsummary:Dataset ;
    ecsummary:description "DataType" ;
    ecsummary:keywords "NaN"^^xsd:double ;

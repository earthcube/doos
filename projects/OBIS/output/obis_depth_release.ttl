    ecsummary:keywords "Occurrence, SPC, PROCFish/C, CoFish, Fish, UVC, Observation" ;
    ecsummary:name "SPC PROCFish/C Fish Observations Papua New Guinea 2006" ;
    ecsummary:place "No spatialCoverage" ;

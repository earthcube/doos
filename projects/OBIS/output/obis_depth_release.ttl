    a ecsummary:Dataset ;
    ecsummary:description "En este estudio se colectaron representantes de hidrozoos y anthozoos. Los organismos solitarios fueron identificados y cuantificados mientras que lo organismos coloniales, en su mayoría fragmentados, fueron identificados pero no cuantificados; por esta razón los resultados se expresan de manera cualitativa." ;
    ecsummary:keywords "Occurrence, Cnidaria, Colombia, La Guajira, Makuriwa, Observation, Fondos blandos de la plataforma de la Guajira" ;
    ecsummary:name "Cnidarios del proyecto Macrofauna Corpoguajira" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/f260b9a8-72a8-44fc-9ddc-383b7d7e54ff> ;
.


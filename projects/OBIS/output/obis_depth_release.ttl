<urn:gleaner.io:oih:obis:data:0f6b0dcc23e84d1d93673f7f84e52e163285a792>
    a ecsummary:Dataset ;
    ecsummary:description "The sampling program was part of a study led by the Canadian Wildlife Service with the objective to determine the plankton composition in the surface waters at two specific locations in the Bay of Fundy. Sampling occurring during six cruises to two areas in the Bay of Fundy: Deer Island and Lords Cove and around Brier island between the years 2002 to 2007. A specialized net was used to collect surface plankton samples. This OBIS dataset contains only presence information data - abundance data will be released at a later date." ;
    ecsummary:keywords "Occurrence, Observation" ;
    ecsummary:name "BioChem: Zooplankton collected from the Bay of Fundy, 2002-2007" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/2a9b0eb5-8000-44e9-b985-be11c228e343> ;
.


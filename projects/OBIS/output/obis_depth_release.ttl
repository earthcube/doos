    a ecsummary:Dataset ;
    ecsummary:description "This dataset contains biological specimens sampled at the seafloor, taken from NSF Ridge2000 expeditions." ;
    ecsummary:keywords "Occurrence, Observation" ;
    ecsummary:name "Marine Geoscience Data System" ;

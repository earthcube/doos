    ecsummary:keywords "Parques Nacionales, Corales de Profundidad, Plancton, Ambientes Mesofóticos, Occurrence, Observation" ;
    ecsummary:name "Monitoreo de plancton mesofótico en el Parque Nacional Natural Corales de profundidad en 2017 y 2018" ;

<urn:gleaner.io:oih:obis:data:42808c5beaece4576a627439b1259f45cbd4cd30>
    a ecsummary:Dataset ;
    ecsummary:description "Deep-sea fish diversity using environmental DNA metabarcoding of pumped deep-sea water is monitored. Water samples were derived from the intakes located at 400m depth off Yaizu, Suruga Bay and 811m depth off Akazawa, Sagami Bay in Japan. Identical reads obtained by next generation sequencing were referred to the MitoFish (http://mitofish.aori.u-tokyo.ac.jp/), and more than 3% of the total reads were listed." ;
    ecsummary:keywords "Occurrence" ;
    ecsummary:name "Monitoring of deep-sea fish diversity using environmental DNA metabarcoding of pumped deep-sea water in Sagami and Suruga Bays, Japan" ;
    ecsummary:place "No spatialCoverage" ;
    ecsummary:publisher "obis" ;
    ecsummary:subjectOf <https://obis.org/dataset/b81d955d-fc21-44fc-aa57-4f44b31e9916> ;
.


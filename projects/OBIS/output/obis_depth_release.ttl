<urn:gleaner.io:oih:obis:data:5a69de728b06d4f9f5736e117c7e19688dc5b661>
    a ecsummary:Dataset ;
    ecsummary:description "Abyssal fauna of the UK-1 polymetallic nodule exploration area, Clarion-Clipperton Zone, central Pacific Ocean: Cnidaria." ;
    ecsummary:keywords "Occurrence" ;
    ecsummary:name "Abyssal fauna of the UK-1 polymetallic nodule exploration area, Clarion-Clipperton Zone, central Pacific Ocean: Cnidaria" ;
    ecsummary:place "No spatialCoverage" ;

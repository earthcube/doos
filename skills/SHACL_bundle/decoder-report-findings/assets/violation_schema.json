{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 4 violation report (04_report.json)",
  "type": "object",
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "object",
      "required": [
        "n_total", "n_violations", "n_warnings", "n_info",
        "n_autofixable", "conforms", "enrichment"
      ],
      "properties": {
        "n_total": { "type": "integer" },
        "n_violations": { "type": "integer" },
        "n_warnings": { "type": "integer" },
        "n_info": { "type": "integer" },
        "n_autofixable": { "type": "integer" },
        "conforms": { "type": "boolean", "description": "True iff zero Violation-severity findings." },
        "enrichment": { "type": "string", "enum": ["llm", "deterministic"] }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "result_id", "severity", "severity_bucket", "focus_node",
          "result_path", "source_constraint", "message",
          "fixType", "autoFixable", "issue", "suggestedFix"
        ],
        "properties": {
          "result_id": { "type": ["string", "null"] },
          "severity": { "type": ["string", "null"], "description": "Raw sh:resultSeverity IRI." },
          "severity_bucket": { "type": "string", "enum": ["violation", "warning", "info"] },
          "focus_node": { "type": ["string", "null"] },
          "result_path": { "type": ["string", "null"] },
          "source_shape": { "type": ["string", "null"] },
          "source_constraint": { "type": ["string", "null"], "description": "sh:sourceConstraintComponent IRI." },
          "value": { "type": ["string", "null"], "description": "Offending value, if any." },
          "message": { "type": ["string", "null"], "description": "Raw SHACL message." },
          "fixType": { "type": "string", "enum": ["add", "coerce", "remove", "reword", "manual"] },
          "autoFixable": { "type": "boolean", "description": "fixType != manual; gates the repair loop." },
          "issue": { "type": "string", "description": "Plain-language explanation (LLM-enriched or deterministic)." },
          "suggestedFix": { "type": "string", "description": "Concrete fix action for Stage 5." }
        }
      }
    }
  }
}

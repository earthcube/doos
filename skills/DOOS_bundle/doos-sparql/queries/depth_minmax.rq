# DepBelowSurf min/max ranges (OIH depth profile).
# Params: LIMIT, GRAPH_FILTER
PREFIX schema: <https://schema.org/>

SELECT DISTINCT ?subj ?minValue ?maxValue ?propertyId ?unitCode ?unitText ?g
WHERE {
  GRAPH ?g {
    ?subj schema:variableMeasured ?vm .
    ?vm a schema:PropertyValue ;
        schema:name ?name ;
        schema:minValue ?minValue ;
        schema:maxValue ?maxValue .
    OPTIONAL { ?vm schema:propertyID ?propertyId . }
    OPTIONAL { ?vm schema:unitCode ?unitCode . }
    OPTIONAL { ?vm schema:unitText ?unitText . }
    FILTER(?name = "DepBelowSurf")
  }
  {{GRAPH_FILTER}}
}
ORDER BY ?minValue
LIMIT {{LIMIT}}

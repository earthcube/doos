# Depth-related variableMeasured names with counts (portable depthAssay).
# Params: LIMIT
PREFIX schema: <https://schema.org/>

SELECT DISTINCT
  ?name
  ?propertyId
  ?unitCode
  ?unitText
  ?repo
  (COUNT(DISTINCT ?subj) AS ?datasetCount)
WHERE {
  GRAPH ?g {
    ?subj schema:variableMeasured ?vm .
    ?vm a schema:PropertyValue ;
        schema:name ?name .
    FILTER(CONTAINS(LCASE(STR(?name)), "depth"))
    OPTIONAL { ?vm schema:propertyID ?propertyId . }
    OPTIONAL { ?vm schema:unitCode ?unitCode . }
    OPTIONAL { ?vm schema:unitText ?unitText . }
  }
  BIND(
    REPLACE(STR(?g), "urn:gleaner.io:([^:]+):([^:]+):data:[^\\s]+", "$2")
    AS ?repo
  )
}
GROUP BY ?name ?propertyId ?unitCode ?unitText ?repo
ORDER BY ?name
LIMIT {{LIMIT}}
